{
  "name": "zoho-crm-ide-extension",
  "displayName": "Zoho CRM IDE Extension",
  "description": "Turn VS Code into a Zoho CRM IDE: Deluge language IntelliSense, in-editor Zoho login, org metadata sync, and Run/Pull/Push for functions across all categories.",
  "version": "1.6.2",
  "publisher": "wanas-apps",
  "author": {
    "name": "Wanas Apps",
    "email": "support@wanasapps.com",
    "url": "https://www.wanasapps.com"
  },
  "license": "MIT",
  "icon": "images/deluge-icon.png",
  "keywords": [
    "deluge",
    "zoho",
    "zoho crm",
    "zoho creator",
    "intellisense"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/wanas-apps/zoho-crm-ide-extension.git"
  },
  "bugs": {
    "url": "https://github.com/wanas-apps/zoho-crm-ide-extension/issues"
  },
  "homepage": "https://github.com/wanas-apps/zoho-crm-ide-extension#readme",
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Formatters",
    "Linters"
  ],
  "activationEvents": [
    "onLanguage:deluge",
    "onStartupFinished",
    "onCommand:zohoDeluge.runFunction",
    "onCommand:zohoDeluge.pullFunction",
    "onCommand:zohoDeluge.pushFunction",
    "onCommand:zohoDeluge.createFunction",
    "onUri"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "authentication": [
      {
        "id": "zoho",
        "label": "Zoho CRM"
      }
    ],
    "mcpServerDefinitionProviders": [
      {
        "id": "zohoDeluge.mcpProvider",
        "label": "Zoho CRM IDE"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "zohoDeluge",
          "title": "Zoho CRM IDE",
          "icon": "images/zoho-activitybar.svg"
        }
      ],
      "panel": [
        {
          "id": "zohoDelugePanel",
          "title": "Zoho CRM",
          "icon": "images/zoho-activitybar.svg"
        }
      ]
    },
    "views": {
      "zohoDeluge": [
        {
          "id": "zohoDeluge.connectionView",
          "name": "Connection",
          "icon": "images/zoho-activitybar.svg"
        },
        {
          "id": "zohoDeluge.functionsView",
          "name": "Functions",
          "icon": "images/zoho-activitybar.svg"
        },
        {
          "id": "zohoDeluge.modulesView",
          "name": "Modules & Fields",
          "icon": "images/zoho-activitybar.svg"
        }
      ],
      "zohoDelugePanel": [
        {
          "id": "zohoDeluge.runHistoryView",
          "name": "Run History",
          "icon": "images/zoho-activitybar.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "zohoDeluge.connectionView",
        "contents": "Connect VS Code to your Zoho CRM org to enable org-aware IntelliSense, metadata sync, and Run/Pull/Push for standalone functions.\n[Sign in to Zoho CRM](command:zohoDeluge.login)\nNo setup needed — sign in with the bundled connector. Advanced users can switch to their own Zoho app credentials in settings.",
        "when": "!zohoDeluge.loggedIn"
      },
      {
        "view": "zohoDeluge.functionsView",
        "contents": "No functions loaded yet.\n[Pull metadata from Zoho](command:zohoDeluge.pullMetadata)",
        "when": "zohoDeluge.loggedIn"
      },
      {
        "view": "zohoDeluge.functionsView",
        "contents": "Sign in to load your org's functions.\n[Sign in to Zoho CRM](command:zohoDeluge.login)",
        "when": "!zohoDeluge.loggedIn"
      },
      {
        "view": "zohoDeluge.modulesView",
        "contents": "No modules loaded yet.\n[Pull metadata from Zoho](command:zohoDeluge.pullMetadata)",
        "when": "zohoDeluge.loggedIn"
      },
      {
        "view": "zohoDeluge.modulesView",
        "contents": "Sign in to load your org's modules and fields.\n[Sign in to Zoho CRM](command:zohoDeluge.login)",
        "when": "!zohoDeluge.loggedIn"
      },
      {
        "view": "zohoDeluge.runHistoryView",
        "contents": "No function runs yet. Open a standalone function and use Run (Live) — results appear here."
      }
    ],
    "commands": [
      {
        "command": "zohoDeluge.login",
        "title": "Sign in to Zoho CRM",
        "category": "Zoho CRM IDE"
      },
      {
        "command": "zohoDeluge.logout",
        "title": "Sign out of Zoho CRM",
        "category": "Zoho CRM IDE"
      },
      {
        "command": "zohoDeluge.showAccount",
        "title": "Account…",
        "category": "Zoho CRM IDE",
        "icon": "$(gear)"
      },
      {
        "command": "zohoDeluge.pullMetadata",
        "title": "Pull Metadata from Zoho CRM",
        "category": "Zoho CRM IDE",
        "icon": "$(sync)"
      },
      {
        "command": "zohoDeluge.showOutput",
        "title": "Show Output Log",
        "category": "Zoho CRM IDE"
      },
      {
        "command": "zohoDeluge.runFunction",
        "title": "Run Function (Live)",
        "category": "Zoho CRM IDE",
        "icon": "$(play)"
      },
      {
        "command": "zohoDeluge.pullFunction",
